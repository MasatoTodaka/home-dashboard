# SwitchBot: SwitchBotアプリ > プロフィール > 設定 > 開発者向けオプション で取得
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Apple カレンダー (CalDAV): appleid.apple.com でアプリ用パスワードを発行して使う
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# 取得対象のカレンダー名をカンマ区切りで絞り込みたい場合のみ指定 (未指定なら全カレンダー)
ICLOUD_CALENDAR_NAMES=

# 天気 (Open-Meteo, APIキー不要): 自宅の緯度経度
WEATHER_LAT=35.6812
WEATHER_LON=139.7671

PORT=3001
