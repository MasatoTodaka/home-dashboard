# SwitchBot: SwitchBotアプリ > プロフィール > 設定 > 開発者向けオプション で取得
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Apple カレンダー (CalDAV): appleid.apple.com でアプリ用パスワードを発行して使う
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# 取得対象のカレンダー名をカンマ区切りで絞り込みたい場合のみ指定 (未指定なら全カレンダー)
ICLOUD_CALENDAR_NAMES=

# 天気 (Open-Meteo, APIキー不要): 自宅の緯度経度
WEATHER_LAT=35.6812
WEATHER_LON=139.7671

# Eufy Smart Scale (eufy Life アプリのログイン情報。非公式API)
EUFY_EMAIL=
EUFY_PASSWORD=

# Eufyの測定データをGoogle Sheetsへ追記する際の書き込み先
# サービスアカウントのメールアドレスをスプレッドシートの共有設定に「編集者」として追加しておくこと
GOOGLE_SHEETS_SPREADSHEET_ID=
# シート下部のタブ名をそのまま指定する(日本語UIで新規作成すると既定で「シート1」になる)
GOOGLE_SHEETS_SHEET_NAME=シート1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 秘密鍵はPEM形式そのまま。改行は \n にエスケープして1行で設定する
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# POST /api/eufy/sync を叩く際に Authorization: Bearer <値> で照合する共有シークレット
SYNC_SECRET=

PORT=3001
